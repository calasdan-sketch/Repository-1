# ---- Server ----
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---- Datastore ----
# Path to the SQLite database file.
DATABASE_PATH=./data/app.sqlite

# ---- Shopify ----
# Your store domain, e.g. my-store.myshopify.com
SHOPIFY_SHOP=your-store.myshopify.com
# Admin API access token from your custom app.
SHOPIFY_ACCESS_TOKEN=
# Secret used to verify incoming webhook HMAC signatures.
SHOPIFY_WEBHOOK_SECRET=
# Admin API version, e.g. 2024-10
SHOPIFY_API_VERSION=2024-10

# ---- AutoDS ----
# AutoDS API base URL (depends on plan/access).
AUTODS_API_BASE=https://api.autods.com
# AutoDS API token/key.
AUTODS_API_TOKEN=
# AutoDS store id (if applicable).
AUTODS_STORE_ID=

# ---- Claude (Anthropic) ----
ANTHROPIC_API_KEY=
# Model to use for generation.
CLAUDE_MODEL=claude-3-5-sonnet-20241022
# Max tokens per completion.
CLAUDE_MAX_TOKENS=1024

# ---- Automation behaviour ----
# When true, AI content and orders auto-publish/auto-fulfill.
# When false, they require manual approval (human-in-the-loop).
AUTO_PUBLISH=false
AUTO_FULFILL=false
# Cron schedule for the recurring price/stock sync job.
SYNC_CRON=*/30 * * * *

# ---- Stock sell-price alert (Gmail) ----
# Ticker to watch and the price ($) at or above which you want to be alerted
# to sell. Run with `npm run stock-alert` (loops) or
# `npm run stock-alert:once` (single check, useful to test your setup).
STOCK_ALERT_TICKER=JEPQ
STOCK_ALERT_SELL_PRICE=31
# How often to check the price during market hours (cron expression).
STOCK_ALERT_CRON=*/15 * * * *
# Gmail address to send from. Requires a Gmail "app password", not your
# normal password: https://myaccount.google.com/apppasswords
# (Google Account -> Security -> 2-Step Verification -> App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where the alert email is sent. Defaults to GMAIL_USER if left blank.
STOCK_ALERT_RECIPIENT_EMAIL=

# ---- Virtual Office (live agent activity dashboard) ----
# View at /virtual-office once the server is running. Shows Claude Code
# subagents as they're reported to POST /virtual-office/report — see the
# README's "Virtual Office" section for the reporter contract. Reporting is
# disabled (503) until a token is set here. Generate one with:
# openssl rand -hex 32
VIRTUAL_OFFICE_REPORT_TOKEN=
# How long a finished (done/error) agent stays visible before disappearing.
VIRTUAL_OFFICE_RETIRE_AFTER_MS=600000
# How long a spawning/running agent can go without an update before it's
# force-marked as needing attention ("no status update received").
VIRTUAL_OFFICE_STALE_AFTER_MS=2700000
